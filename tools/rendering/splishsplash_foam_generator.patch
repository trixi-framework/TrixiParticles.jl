 Real clampAndNormalize(const Real val, const Real minVal, const Real maxVal)
 {
+	// An absent potential has zero dynamic range. Treat it as zero rather than
+	// allowing 0/0 to suppress all other independent generation potentials.
+	if (maxVal == minVal)
+		return 0.0;
 	return (std::min(val, maxVal) - std::min(val, minVal)) / (maxVal - minVal);
 }
 
